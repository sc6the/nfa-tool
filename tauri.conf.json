{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NFA Loader",
  "version": "1.0.0",
  "identifier": "app.nfa.loader",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NFA Loader",
        "width": 520,
        "height": 740,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
